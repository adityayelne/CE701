# CompilerLab Backend Environment Configuration
# Copy this file to .env and configure as needed.

# Server settings
HOST=127.0.0.1
PORT=8000
DEBUG=True

# LLM Provider Configuration
# Set LLM_PROVIDER to "groq" to enable Qwen-powered AI compiler repairs,
# or "offline" to use the deterministic local compiler engine.
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_TOKENS=900
